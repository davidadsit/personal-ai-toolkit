#!/bin/sh
# Blocks a push whose new lines contain personal terms kept in a private dashboard workspace.

workspace="$(git config --get personal-ai.private-workspace)"
if [ -z "$workspace" ]; then
  echo "pre-push: blocked. Set git config personal-ai.private-workspace to your private dashboard workspace so pushes can be checked for personal data." >&2
  exit 1
fi

terms="$(mktemp)"
trap 'rm -f "$terms"' EXIT
{
  jq -r '.keyPeople[]?' "$workspace/dashboard.json" 2>/dev/null
  grep -v -E '^[[:space:]]*(#|$)' "$workspace/public-denylist.txt" 2>/dev/null
  git config --get user.email
} | grep -v -E '^[[:space:]]*$' >"$terms"

zero="0000000000000000000000000000000000000000"
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$local_sha" = "$zero" ]; then
    continue
  fi
  if [ "$remote_sha" = "$zero" ]; then
    added="$(git log -p --format= "$local_sha" --not --remotes | grep '^+' | grep -v '^+++')"
  else
    added="$(git log -p --format= "$remote_sha..$local_sha" | grep '^+' | grep -v '^+++')"
  fi
  found="$(printf '%s\n' "$added" | grep -o -i -w -F -f "$terms" | sort -u)"
  if [ -n "$found" ]; then
    echo "pre-push: blocked. $remote_ref would publish these personal terms:" >&2
    printf '%s\n' "$found" | sed 's/^/  /' >&2
    status=1
  fi
done
exit $status
