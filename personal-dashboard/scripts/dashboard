#!/bin/sh
set -e
code="$(cd "$(dirname "$0")/.." && pwd)"
out="$code/.build"
if [ ! -f "$out/dashboard.dll" ] || [ -n "$(find "$code/src" -newer "$out/dashboard.dll" -type f ! -path '*/obj/*' ! -path '*/bin/*' -print -quit)" ]; then
  dotnet build "$code/src/Dashboard" -c Release -o "$out" --nologo -v quiet >/dev/null
fi
exec dotnet "$out/dashboard.dll" "$@"
